---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-cream-200 bg-cream-50/95 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
    aria-label="Main navigation"
  >
    <a href="/" class="flex flex-col leading-tight no-underline">
      <span class="font-serif text-lg font-bold text-ink-900">{site.shortName}</span>
      <span class="text-xs font-semibold uppercase tracking-wider text-sage-600">
        {site.credential} &middot; Therapy in North Texas
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`rounded-full px-3 py-2 text-sm font-semibold no-underline transition-colors ${
                isActive(item.href)
                  ? 'bg-sage-100 text-sage-700'
                  : 'text-ink-700 hover:bg-cream-100'
              }`}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/contact"
          class="ml-2 inline-flex rounded-full bg-periwinkle-500 px-4 py-2 text-sm font-semibold text-cream-50 no-underline transition-colors hover:bg-periwinkle-600"
        >
          Request a Consultation
        </a>
      </li>
    </ul>

    <!-- Mobile menu (CSS-only via details/summary) -->
    <details class="relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-sage-100 px-4 py-2 text-sm font-semibold text-sage-700"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <ul
        class="absolute right-0 mt-2 w-60 rounded-2xl border border-cream-200 bg-white p-2 shadow-lg"
      >
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={`block rounded-xl px-4 py-2.5 text-sm font-semibold no-underline ${
                  isActive(item.href)
                    ? 'bg-sage-100 text-sage-700'
                    : 'text-ink-700 hover:bg-cream-100'
                }`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mt-1 border-t border-cream-200 pt-2">
          <a
            href="/contact"
            class="block rounded-xl bg-periwinkle-500 px-4 py-2.5 text-center text-sm font-semibold text-cream-50 no-underline"
          >
            Request a Consultation
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>
