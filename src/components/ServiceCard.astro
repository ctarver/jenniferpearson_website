---
interface Props {
  title: string;
  blurb: string;
}
const { title, blurb } = Astro.props;
---

<div
  class="rounded-2xl border border-cream-200 bg-white p-6 shadow-sm transition-shadow duration-200 hover:shadow-md"
>
  <h3 class="text-xl text-sage-700">{title}</h3>
  <p class="mt-2 text-ink-700">{blurb}</p>
</div>
