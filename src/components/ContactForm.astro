---
import { site, focusAreas, insurances } from '../data/site';
import FormDisclaimer from './FormDisclaimer.astro';

const redirect = new URL('/thank-you', site.url).href;
const field =
  'mt-1.5 block w-full rounded-xl border border-cream-200 bg-white px-4 py-3 text-ink-900 shadow-sm focus:border-sage-400';
const label = 'block text-sm font-semibold text-ink-800';
const legend = 'text-sm font-semibold text-ink-800';
const choice = 'inline-flex items-center gap-2 text-sm text-ink-800';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-6"
>
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value="New consultation request from your website" />
  <input type="hidden" name="from_name" value="Website Contact Form" />
  <input type="hidden" name="redirect" value={redirect} />
  <!-- Honeypot: bots fill this; humans never see it -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <FormDisclaimer />

  <!-- Contact details -->
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="name">Your name <span class="text-alert-600">*</span></label>
      <input class={field} id="name" name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label class={label} for="phone">
        Phone <span class="font-normal text-ink-700">(optional)</span>
      </label>
      <input class={field} id="phone" name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>

  <div>
    <label class={label} for="email">Email <span class="text-alert-600">*</span></label>
    <input class={field} id="email" name="email" type="email" required autocomplete="email" />
    <p class="mt-1.5 text-sm text-ink-700">
      I'll reach out from my secure, HIPAA-compliant email to schedule your free
      consultation, usually within two business days.
    </p>
  </div>

  <hr class="border-cream-200" />

  <!-- Payment -->
  <fieldset>
    <legend class={legend}>How are you planning to pay? <span class="text-alert-600">*</span></legend>
    <div class="mt-2 flex flex-wrap gap-4">
      <label class={choice}>
        <input type="radio" name="payment" value="Using insurance" required /> Using insurance
      </label>
      <label class={choice}>
        <input type="radio" name="payment" value="Self-pay" required /> Self-pay
      </label>
      <label class={choice}>
        <input type="radio" name="payment" value="Not sure yet" required /> Not sure yet
      </label>
    </div>
    <div class="mt-3">
      <label class={label} for="insurer">
        If using insurance, which provider? <span class="font-normal text-ink-700">(optional)</span>
      </label>
      <select class={field} id="insurer" name="insurer">
        <option value="">Select your insurer…</option>
        {insurances.map((ins) => <option value={ins}>{ins}</option>)}
        <option value="Other / not listed">Other / not listed</option>
      </select>
    </div>
  </fieldset>

  <!-- Areas of focus -->
  <fieldset>
    <legend class={legend}>
      What would you like support with? <span class="font-normal text-ink-700">(optional, check any)</span>
    </legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      {
        focusAreas.map((area) => (
          <label class={choice}>
            <input type="checkbox" name="areas_of_focus" value={area} /> {area}
          </label>
        ))
      }
      <label class={choice}>
        <input type="checkbox" name="areas_of_focus" value="Not sure / something else" /> Not sure / something else
      </label>
    </div>
  </fieldset>

  <!-- Availability -->
  <fieldset>
    <legend class={legend}>
      General availability <span class="font-normal text-ink-700">(optional)</span>
    </legend>
    <div class="mt-2 flex flex-wrap gap-4">
      <label class={choice}>
        <input type="checkbox" name="availability" value="Weekday mornings" /> Weekday mornings
      </label>
      <label class={choice}>
        <input type="checkbox" name="availability" value="Weekday afternoons" /> Weekday afternoons
      </label>
    </div>
    <input
      class={`${field} mt-3`}
      id="availability_notes"
      name="availability_notes"
      type="text"
      placeholder="Any specific days or times that work best?"
    />
  </fieldset>

  <!-- Waitlist -->
  <label class="flex items-start gap-3 rounded-xl border border-cream-200 bg-cream-50 p-4 text-sm text-ink-800">
    <input type="checkbox" name="waitlist_ok" value="Yes, open to the waitlist" class="mt-1" />
    <span>I'm open to joining the waitlist if there isn't an immediate opening that fits.</span>
  </label>

  <!-- Open message -->
  <div>
    <label class={label} for="message">
      Tell me a bit about what's bringing you in <span class="font-normal text-ink-700">(optional)</span>
    </label>
    <p class="mt-1 text-sm text-ink-700">
      Share as much or as little as feels comfortable, the more context you give, the
      better I can help. Since this form isn't HIPAA-secure, please leave out your most
      sensitive details; we'll have room for those once I follow up by secure email.
    </p>
    <textarea
      class={`${field} mt-1.5`}
      id="message"
      name="message"
      rows="4"
      placeholder="Whatever you'd like me to know."></textarea>
  </div>

  <hr class="border-cream-200" />

  <!-- Eligibility confirm -->
  <label class="flex items-start gap-3 text-sm text-ink-800">
    <input type="checkbox" name="eligibility_confirm" value="Confirmed 18+ and located in Texas" required class="mt-1" />
    <span>I confirm I'm 18 or older and currently located in Texas. <span class="text-alert-600">*</span></span>
  </label>

  <button
    type="submit"
    class="inline-flex w-full items-center justify-center rounded-full bg-periwinkle-500 px-7 py-3.5 text-base font-semibold text-cream-50 transition-colors hover:bg-periwinkle-600 sm:w-auto"
  >
    Send my request
  </button>
</form>
