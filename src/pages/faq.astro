---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import { faqs } from '../data/site';

// FAQPage structured data for SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about therapy with Jennifer Pearson, LCSW: getting started, sessions, insurance and fees, confidentiality, telehealth, and more."
>
  <section class="bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-sage-600">FAQ</p>
      <h1 class="text-4xl sm:text-5xl">Questions you might have</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-700">
        Starting therapy can bring up a lot of questions. Here are some of the ones I
        hear most often. If yours isn't here, please reach out, I'm always glad to help.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <div class="space-y-4">
      {
        faqs.map((f) => (
          <details class="group rounded-2xl border border-cream-200 bg-white p-5 shadow-sm open:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-ink-900">
              <span>{f.question}</span>
              <span
                class="shrink-0 text-sage-600 transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-ink-700">{f.answer}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl bg-sage-50 p-8 text-center">
      <h2 class="text-2xl">Still have a question?</h2>
      <p class="mx-auto mt-3 max-w-md text-ink-700">
        I'm happy to answer anything before we begin. Reach out and we'll take it from
        there, no pressure..
      </p>
      <div class="mt-6">
        <CTAButton href="/contact">Request a Free Consultation</CTAButton>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
