---
import BaseLayout from '../layouts/BaseLayout.astro';
import { crisisNational, crisisLocal } from '../data/site';
---

<BaseLayout
  title="Crisis Resources"
  description="If you are in crisis, help is available 24/7. National and North Texas crisis lines, including 988, Crisis Text Line, and Tarrant County resources."
>
  <!-- Emergency callout -->
  <section class="bg-alert-700 text-cream-50">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center">
      <h1 class="text-4xl text-cream-50 sm:text-5xl">You deserve support right now</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg">
        If you or someone you love is in immediate danger, please call
        <a href="tel:911" class="font-semibold underline">911</a>.
        You don't have to face this alone, the resources below are free,
        confidential, and available 24/7.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="tel:988"
          class="inline-flex items-center justify-center rounded-full bg-cream-50 px-7 py-3 text-base font-semibold text-alert-700 no-underline"
        >
          Call or text 988
        </a>
        <a
          href="sms:741741?&body=HOME"
          class="inline-flex items-center justify-center rounded-full bg-transparent px-7 py-3 text-base font-semibold text-cream-50 no-underline ring-2 ring-cream-50"
        >
          Text HOME to 741741
        </a>
      </div>
    </div>
  </section>

  <!-- National -->
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-3xl">National Crisis Lines</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        crisisNational.map((r) => (
          <div class="rounded-2xl border border-cream-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg text-sage-700">{r.name}</h3>
            <p class="mt-1 text-xl font-semibold text-ink-900">
              {r.contactHref ? (
                <a href={r.contactHref} class="no-underline hover:text-sage-700">
                  {r.contact}
                </a>
              ) : (
                r.contact
              )}
            </p>
            {r.note && <p class="mt-2 text-sm text-ink-700">{r.note}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Local -->
  <section class="bg-sage-50">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <h2 class="text-3xl">North Texas &amp; Tarrant County</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {
          crisisLocal.map((r) => (
            <div class="rounded-2xl border border-cream-200 bg-white p-6 shadow-sm">
              <h3 class="text-lg text-sage-700">{r.name}</h3>
              <p class="mt-1 text-xl font-semibold text-ink-900">
                {r.contactHref ? (
                  <a href={r.contactHref} class="no-underline hover:text-sage-700">
                    {r.contact}
                  </a>
                ) : (
                  r.contact
                )}
              </p>
              {r.note && <p class="mt-2 text-sm text-ink-700">{r.note}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- When to call 911 -->
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-3xl">When to call 911</h2>
    <p class="mt-4 text-lg text-ink-700">Please call 911 or go to your nearest emergency room if:</p>
    <ul class="mt-4 list-disc space-y-2 pl-6 text-ink-700">
      <li>You or someone else is in immediate physical danger.</li>
      <li>There are thoughts of suicide with a plan or intent to act.</li>
      <li>Someone is threatening to harm themselves or others.</li>
      <li>There's a medical emergency, overdose, or loss of consciousness.</li>
    </ul>
    <p class="mt-6 text-ink-700">
      These resources are not affiliated with this practice; they are provided for your
      safety and convenience. Numbers are current to the best of my knowledge, if one
      isn't working, please call 911 or 988.
    </p>
  </section>
</BaseLayout>
